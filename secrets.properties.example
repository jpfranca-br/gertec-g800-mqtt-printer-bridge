# Copy to secrets.properties (never commit it) and fill in.
# tools/push_config.py turns this into config.json on the POS; tools/mqtt.py uses it too.

# mqtts:// = TLS (default port 8883), mqtt:// = plain (default port 1883)
mqtt.url=mqtts://mqtt.example.com:8883
mqtt.user=pos
mqtt.password=CHANGE_ME

# Topics: <topic.root>/<device id>/...   (device id = POS serial number unless overridden)
topic.root=pos
# device.id=my-pos-1

# Extra CA certificate(s) to trust (PEM), for a private CA or self-signed broker.
# Public CAs and Let's Encrypt are already trusted.
# ca.file=C:/path/to/ca.pem

# Home Assistant MQTT discovery (default true) and its topic prefix
# ha.discovery=true
# ha.prefix=homeassistant

# PIN required to open the Settings screen on the POS
# settings.pin=1234
